# PlayFix configuration — copy to `.env` and fill in.

# REQUIRED: your Discord bot token (Developer Portal → your app → Bot → Reset Token).
PLAYFIX_TOKEN=your-bot-token-here

# --- Optional (defaults shown) ---
# PLAYFIX_LOG_LEVEL=INFO
# PLAYFIX_DEFAULT_MODE=webhook            # webhook = post as the author; reply = non-destructive
# PLAYFIX_DEFAULT_DELETE_ORIGINAL=true    # in webhook mode, delete the original message
# PLAYFIX_DB_PATH=data/playfix.sqlite3
# PLAYFIX_MAX_ATTACHMENT_MB=8

# --- Embed fallback ---
# When a fixer draws no embed, PlayFix retries the link on that site's spare fixer
# (TikTok: tnktok.com -> tiktokez.com). It waits DELAY seconds per look and only
# swaps after ATTEMPTS looks have all come back empty.
# PLAYFIX_EMBED_FALLBACK=true
# PLAYFIX_EMBED_CHECK_DELAY=4.0
# PLAYFIX_EMBED_CHECK_ATTEMPTS=2
